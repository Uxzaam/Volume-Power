<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volume Power"
            android:textAppearance="?attr/textAppearanceHeadlineLarge"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            style="@style/VppBody"
            android:layout_marginTop="4dp"
            android:text="Wakes the screen when it is off, locks it when it is on." />

        <TextView
            style="@style/VppSection"
            android:text="Status" />
        <LinearLayout
            android:id="@+id/statusList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/VppSection"
            android:text="General" />
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swEnable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Enable volume key as power" />
        <TextView
            style="@style/VppBody"
            android:layout_marginTop="12dp"
            android:text="Trigger key" />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKeyUp"
                style="?attr/materialButtonOutlinedStyle"
                android:text="Volume up" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKeyDown"
                style="?attr/materialButtonOutlinedStyle"
                android:text="Volume down" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            style="@style/VppSection"
            android:text="Shizuku (recommended)" />
        <TextView
            style="@style/VppBody"
            android:text="Gives the app ADB-level access with no PC and no root. It reads the real volume button, so the screen turns on with the screen off even while other apps play media, and it can lock the phone even if accessibility is switched off." />
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swShizuku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Use Shizuku for the volume key" />
        <Button
            android:id="@+id/btnShizukuInstall"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="1. Get Shizuku" />
        <Button
            android:id="@+id/btnShizukuOpen"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. Open Shizuku and start it" />
        <Button
            android:id="@+id/btnShizukuAllow"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3. Allow this app" />
        <Button
            android:id="@+id/btnGrantAll"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4. Grant all permissions" />
        <TextView
            android:id="@+id/txtGrant"
            style="@style/VppBody"
            android:layout_marginTop="8dp"
            android:text="Grants: secure settings, notifications, restricted settings, run in background, battery whitelist." />

        <TextView
            style="@style/VppSection"
            android:text="Stability" />
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swBoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Start on boot" />
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swHeal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Re-enable accessibility automatically" />
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swKeepAlive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Silent audio keep-alive" />
        <Button
            android:id="@+id/btnAccessibility"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Accessibility settings" />
        <Button
            android:id="@+id/btnBattery"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Turn off battery optimisation" />

        <TextView
            style="@style/VppSection"
            android:text="Appearance" />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnThemeSystem"
                style="?attr/materialButtonOutlinedStyle"
                android:text="System" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnThemeLight"
                style="?attr/materialButtonOutlinedStyle"
                android:text="Day" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnThemeDark"
                style="?attr/materialButtonOutlinedStyle"
                android:text="Night" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            style="@style/VppSection"
            android:text="Notification priority" />
        <TextView
            style="@style/VppBody"
            android:text="Android always shows a notification while the service runs. Hidden makes it silent and collapsed." />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleNotif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNotifHidden"
                style="?attr/materialButtonOutlinedStyle"
                android:text="Hidden" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNotifLow"
                style="?attr/materialButtonOutlinedStyle"
                android:text="Low" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNotifNormal"
                style="?attr/materialButtonOutlinedStyle"
                android:text="Normal" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            style="@style/VppSection"
            android:text="Device admin" />
        <TextView
            style="@style/VppBody"
            android:text="Optional. Lets the app lock the screen with the admin API if the normal lock action fails." />
        <Button
            android:id="@+id/btnAdmin"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Make device admin" />
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swAdminLock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Always lock with admin (PIN needed after)"
            android:visibility="gone" />

        <TextView
            style="@style/VppSection"
            android:text="Manual ADB (only without Shizuku)" />
        <TextView
            style="@style/VppBody"
            android:text="One time. Lets the app turn its accessibility service back on by itself.\n\n1. Settings, About phone: tap Build number 7 times.\n2. Developer options: turn on Wireless debugging.\n3. From a PC or Termux (pkg install android-tools) run adb pair, then adb connect.\n4. Run this command:" />
        <TextView
            android:id="@+id/txtCommand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:background="?attr/colorSurfaceContainerHighest"
            android:textColor="?attr/colorOnSurface"
            android:textIsSelectable="true"
            android:textSize="12sp" />
        <Button
            android:id="@+id/btnCopy"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Copy command" />
        <Button
            android:id="@+id/btnDev"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open developer options" />
    </LinearLayout>
</ScrollView>
